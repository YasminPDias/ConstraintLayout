<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#222222"
    tools:context=".SerieActivity">

    <TextView
        android:id="@+id/txtHeaderNetflix"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="#E50914"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:text="Netflix"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtSerieTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Heartland"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:layout_marginTop="24dp"
        android:drawableBottom="@drawable/ic_arrow_drop_down"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/txtHeaderNetflix"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtEpisode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="T10:E08"
        android:textColor="#AAAAAA"
        android:textSize="14sp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/txtSerieTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/imgMediaCover"
        android:layout_width="0dp"
        android:layout_height="220dp"
        android:scaleType="centerCrop"
        android:src="@drawable/heartland_banner"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/txtEpisode"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <SeekBar
        android:id="@+id/seekBarProgress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:layout_marginHorizontal="16dp"
        android:progress="33"
        android:max="100"
        android:progressTint="#E50914"
        android:thumbTint="#E50914"
        app:layout_constraintTop_toBottomOf="@id/imgMediaCover"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtTimeCurrent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="20:00"
        android:textColor="#FFFFFF"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toBottomOf="@id/seekBarProgress"
        app:layout_constraintStart_toStartOf="@id/seekBarProgress" />

    <TextView
        android:id="@+id/txtTimeTotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="40:00"
        android:textColor="#FFFFFF"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toBottomOf="@id/seekBarProgress"
        app:layout_constraintEnd_toEndOf="@id/seekBarProgress" />

    <ImageView
        android:id="@+id/btnReplay10"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_replay_10"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/txtTimeCurrent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnPlayPause"
        app:layout_constraintHorizontal_chainStyle="spread" />

    <ImageView
        android:id="@+id/btnPlayPause"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_play_arrow"
        app:layout_constraintTop_toTopOf="@id/btnReplay10"
        app:layout_constraintBottom_toBottomOf="@id/btnReplay10"
        app:layout_constraintStart_toEndOf="@id/btnReplay10"
        app:layout_constraintEnd_toStartOf="@id/btnSettings" />

    <ImageView
        android:id="@+id/btnSettings"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_video_settings"
        app:layout_constraintTop_toTopOf="@id/btnReplay10"
        app:layout_constraintBottom_toBottomOf="@id/btnReplay10"
        app:layout_constraintStart_toEndOf="@id/btnPlayPause"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>